{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/brand/**",
              "components/lists/**",
              "components/media/**",
              "components/offer/**",
              "ui_kits/offer-booklet/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Barlow|Barlow Condensed))/i]",
        "message": "Font not provided by the design system. Available: Barlow, Barlow Condensed."
      },
      {
        "selector": "JSXOpeningElement[name.name='AccentRule'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|tone|style|key|ref|className|style|children)$/]",
        "message": "<AccentRule> doesn't accept that prop. Declared props: variant, tone, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='AccentRule'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:flourish|hairline|bar)$/]",
        "message": "<AccentRule> variant must be one of 'flourish' | 'hairline' | 'bar'."
      },
      {
        "selector": "JSXOpeningElement[name.name='AccentRule'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:essential|live|full)$/]",
        "message": "<AccentRule> tone must be one of 'essential' | 'live' | 'full'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Chip'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|active|onClick|style|key|ref|className|style|children)$/]",
        "message": "<Chip> doesn't accept that prop. Declared props: children, active, onClick, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Eyebrow'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|tone|weight|style|key|ref|className|style|children)$/]",
        "message": "<Eyebrow> doesn't accept that prop. Declared props: children, tone, weight, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Eyebrow'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:accent|essential|live|full|muted|heading)$/]",
        "message": "<Eyebrow> tone must be one of 'accent' | 'essential' | 'live' | 'full' | 'muted' | 'heading'."
      },
      {
        "selector": "JSXOpeningElement[name.name='InfoTile'] > JSXAttribute > JSXIdentifier[name!=/^(?:color|children|style|key|ref|className|style|children)$/]",
        "message": "<InfoTile> doesn't accept that prop. Declared props: color, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='NumberedItem'] > JSXAttribute > JSXIdentifier[name!=/^(?:n|children|style|key|ref|className|style|children)$/]",
        "message": "<NumberedItem> doesn't accept that prop. Declared props: n, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='PhotoSection'] > JSXAttribute > JSXIdentifier[name!=/^(?:image|scrim|dim|height|position|children|style|key|ref|className|style|children)$/]",
        "message": "<PhotoSection> doesn't accept that prop. Declared props: image, scrim, dim, height, position, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='PhotoSection'] > JSXAttribute[name.name='scrim'] > Literal[value!=/^(?:bottom|left)$/]",
        "message": "<PhotoSection> scrim must be one of 'bottom' | 'left'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Price'] > JSXAttribute > JSXIdentifier[name!=/^(?:amount|suffix|size|style|key|ref|className|style|children)$/]",
        "message": "<Price> doesn't accept that prop. Declared props: amount, suffix, size, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='PromoVideo'] > JSXAttribute > JSXIdentifier[name!=/^(?:thumbnail|eyebrow|title|url|qr|qrLabel|style|key|ref|className|style|children)$/]",
        "message": "<PromoVideo> doesn't accept that prop. Declared props: thumbnail, eyebrow, title, url, qr, qrLabel, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='SectionTitle'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|size|as|style|key|ref|className|style|children)$/]",
        "message": "<SectionTitle> doesn't accept that prop. Declared props: children, size, as, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='SectionTitle'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:xl|lg|md|sm)$/]",
        "message": "<SectionTitle> size must be one of 'xl' | 'lg' | 'md' | 'sm'."
      },
      {
        "selector": "JSXOpeningElement[name.name='SectionTitle'] > JSXAttribute[name.name='as'] > Literal[value!=/^(?:h1|h2|h3|h4|div)$/]",
        "message": "<SectionTitle> as must be one of 'h1' | 'h2' | 'h3' | 'h4' | 'div'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Song'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|artist|key|ref|className|style|children)$/]",
        "message": "<Song> doesn't accept that prop. Declared props: title, artist."
      },
      {
        "selector": "JSXOpeningElement[name.name='StatFigure'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|value|unit|style|key|ref|className|style|children)$/]",
        "message": "<StatFigure> doesn't accept that prop. Declared props: label, value, unit, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='TierCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:tone|name|meta|price|children|style|key|ref|className|style|children)$/]",
        "message": "<TierCard> doesn't accept that prop. Declared props: tone, name, meta, price, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='TierCard'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:essential|live|full)$/]",
        "message": "<TierCard> tone must be one of 'essential' | 'live' | 'full'."
      },
      {
        "selector": "JSXOpeningElement[name.name='TierChoice'] > JSXAttribute > JSXIdentifier[name!=/^(?:tone|name|children|selected|onClick|style|key|ref|className|style|children)$/]",
        "message": "<TierChoice> doesn't accept that prop. Declared props: tone, name, children, selected, onClick, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='TierChoice'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:essential|live|full)$/]",
        "message": "<TierChoice> tone must be one of 'essential' | 'live' | 'full'."
      },
      {
        "selector": "JSXOpeningElement[name.name='TierStrip'] > JSXAttribute > JSXIdentifier[name!=/^(?:tone|name|meta|style|key|ref|className|style|children)$/]",
        "message": "<TierStrip> doesn't accept that prop. Declared props: tone, name, meta, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='TierStrip'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:essential|live|full)$/]",
        "message": "<TierStrip> tone must be one of 'essential' | 'live' | 'full'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Wordmark'] > JSXAttribute > JSXIdentifier[name!=/^(?:size|stacked|accentX|style|key|ref|className|style|children)$/]",
        "message": "<Wordmark> doesn't accept that prop. Declared props: size, stacked, accentX, style."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
